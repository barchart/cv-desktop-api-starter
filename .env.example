# Copy this file to .env and fill in your OpenFeed credentials.
# The setup scripts do this interactively and keep a synced copy of the
# result inside every language folder (python/.env, typescript/.env, etc.) so each
# app can just read ".env" from its own folder.
#
# To change your credentials later, either:
#   - re-run a setup script (it'll ask "Set fresh credentials?"), or
#   - edit any of those .env files by hand and re-run the app - no need to
#     touch every copy, since the next setup run re-syncs them all anyway.

OPENFEED_USERNAME=
OPENFEED_PASSWORD=

# WebSocket server. The setup scripts only ask you for the Desktop API port
# (the server is always localhost) and build this value for
# you automatically. Used by Python, Node, Go and C#; Java reads host/port
# separately (see java/src).
OPENFEED_WS_URL=ws://localhost:9000
