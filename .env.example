# Copy this file to .env and fill in your OpenFeed credentials
# (the setup scripts do this for you interactively - you shouldn't need to edit this by hand)

OPENFEED_USERNAME=
OPENFEED_PASSWORD=

# WebSocket server. The setup scripts only ask you for the Desktop API port
# (the server is always localhost) and build this value for
# you automatically. Used by Python, Node, Go and C#; Java reads host/port
# separately (see java/src).
OPENFEED_WS_URL=ws://localhost:9000
