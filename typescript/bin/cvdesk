#!/usr/bin/env node
// The TypeScript-only cvdesk command of earlier versions: `cvdesk <script> [arguments]`
// type-checks and runs a script from my-scripts/ or examples/, from any folder
// (see scripts/run.ts), and `cvdesk update` installs the newest version of this
// folder (see scripts/update.mjs).
// When the project has the cvdesk command for every language (../bin/cvdesk),
// this hands over to it instead. Setup now puts that one on PATH, but a PATH
// that an earlier setup pointed here keeps working this way.
// On Windows, cvdesk.cmd next to this file is what the terminal runs.
import { spawnSync } from "node:child_process";
import fs from "node:fs";
import { fileURLToPath } from "node:url";

const fromProject = (p) => fileURLToPath(new URL(`../${p}`, import.meta.url));
const [command, ...args] = process.argv.slice(2);
const everyLanguage = fromProject("../bin/cvdesk");
// (On Windows, cvdesk.cmd hands over to bin\cvdesk.cmd itself.)
const result = process.platform !== "win32" && fs.existsSync(everyLanguage)
    // Through bash, so it runs even if a download lost the file's executable flag.
    ? spawnSync("bash", [everyLanguage, ...process.argv.slice(2)], { stdio: "inherit" })
    : command === "update"
        ? spawnSync(process.execPath, [fromProject("scripts/update.mjs"), ...args], { stdio: "inherit" })
        : spawnSync(process.execPath,
            [fromProject("node_modules/tsx/dist/cli.mjs"), fromProject("scripts/run.ts"), ...process.argv.slice(2)],
            { stdio: "inherit" });
process.exit(result.status ?? 1);
