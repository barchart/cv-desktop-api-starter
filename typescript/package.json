{
  "name": "openfeed-starter-node",
  "version": "1.0.0",
  "description": "OpenFeed SDK starter example (Node.js/TypeScript)",
  "type": "module",
  "scripts": {
    "start": "tsx scripts/run.ts src/start-guide.ts",
    "file": "tsx scripts/run.ts",
    "dev": "tsx watch src/start-guide.ts",
    "typecheck": "tsc --noEmit",
    "install-commands": "tsx scripts/install-commands.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@barchart/desktop-sdk-js": "^0.1.1",
    "@openfeed/sdk-js": "^1.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  }
}
