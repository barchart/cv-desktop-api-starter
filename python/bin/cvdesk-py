#!/usr/bin/env bash
# The cvdesk-py command: `cvdesk-py <script> [arguments]` runs a script from
# my-scripts/ or examples/ with this project's venv, from any folder, without
# activating it (see scripts/run.py). `cvdesk-py update` installs the newest
# version of this project (see scripts/update.py).
# setup.command (macOS) and setup.bat (Windows) add this bin/ folder to PATH.
# On Windows, cvdesk-py.cmd next to this file is what the terminal runs.
project="$(cd "$(dirname "$0")/.." && pwd)"
python="$project/venv/bin/python"
if [ ! -x "$python" ]; then
  echo "This project has no venv yet. Run its setup again: $project/setup.command" >&2
  exit 1
fi
exec "$python" "$project/scripts/run.py" "$@"
