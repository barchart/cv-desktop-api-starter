<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.barchart.openfeed</groupId>
    <artifactId>openfeed-client</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>OpenFeed Java Client</name>
    <!-- Only lists the libraries the scripts use. scripts/dependencies.sh copies them
         into lib/, and cvdesk runs each script in examples/ or my-scripts/ with them. -->
    <description>Java client for OpenFeed market data</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- OpenFeed SDK (includes its own protobuf dependencies) -->
        <dependency>
            <groupId>org.openfeed</groupId>
            <artifactId>openfeed-client</artifactId>
            <version>1.0.17</version>
        </dependency>

        <!-- Protocol Buffers - must match SDK's compiled version -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>4.28.3</version>
        </dependency>

        <!-- Protocol Buffers Util - required for JSON logging -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java-util</artifactId>
            <version>4.28.3</version>
        </dependency>

        <!-- Agrona (required by OpenFeed for collections) -->
        <dependency>
            <groupId>org.agrona</groupId>
            <artifactId>agrona</artifactId>
            <version>1.21.1</version>
        </dependency>

        <!-- Guava (required by OpenFeed) -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.0.0-jre</version>
        </dependency>

        <!-- Netty (required for WebSocket implementation) -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <version>4.1.100.Final</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.9</version>
        </dependency>
    </dependencies>
</project>
